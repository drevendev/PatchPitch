# Optional process settings. The app does not read .env automatically.
PATCHPITCH_MODEL=gemma4:12b
PATCHPITCH_TIMEOUT=420
# No hosted API keys or paid fallback are used.
# Optional Sentry metadata export; absent/empty means no telemetry.
# Set in the process environment; this file is not loaded automatically.
PATCHPITCH_SENTRY_DSN=
# Optional exact 40-character Git commit SHA for trace release identity.
PATCHPITCH_SENTRY_RELEASE=
